#!/bin/bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
. "$CONFIG_DIR/colors.sh"

# Keep the 40-point footprint used by Rectangle; only the pills are visible.
# The clock's 5-point item padding completes the 20-point right margin.
sketchybar --bar position=top height=40 color="$BAR_COLOR" blur_radius=0 \
  topmost=window font_smoothing=on shadow=off padding_left=20 padding_right=15

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Regular:16.0"
  label.font="Helvetica Neue:Medium:13.0"
  icon.color="$TEXT_COLOR"
  label.color="$TEXT_COLOR"
  icon.padding_left=10
  icon.padding_right=0
  label.padding_left=10
  label.padding_right=10
  background.drawing=on
  background.color="$ITEM_COLOR"
  background.height=24
  background.corner_radius=10
  background.border_width=2
  background.border_color="$BORDER_COLOR"
  blur_radius=20
)
sketchybar --default "${default[@]}"

sketchybar --add event flashspace_workspace_change
SID=1
WORKSPACES=()
while IFS= read -r workspace; do
  printf -v workspace_arg '%q' "$workspace"
  WORKSPACES+=("flashspace.$SID")
  sketchybar --add item flashspace.$SID left \
    --set flashspace.$SID \
      icon.drawing=off \
      label="$workspace" \
      label.color="$MUTED_COLOR" \
      label.padding_left=8 \
      label.padding_right=8 \
      padding_left=0 padding_right=0 \
      background.drawing=off background.height=20 background.border_width=0 \
      script="\"$PLUGIN_DIR/flashspace.sh\" $workspace_arg" \
      click_script="flashspace workspace --number $SID" \
    --subscribe flashspace.$SID flashspace_workspace_change
  SID=$((SID + 1))
done < <(flashspace list-workspaces)

if [ ${#WORKSPACES[@]} -gt 0 ]; then
  sketchybar --add bracket workspaces "${WORKSPACES[@]}" \
    --set workspaces background.drawing=on \
      background.padding_left=4 background.padding_right=4
fi

sketchybar --add item front_app left \
  --set front_app icon.drawing=off \
    label.font="Helvetica Neue:Bold:13.0" \
    padding_left=10 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Right-side items are added from the outside in.
sketchybar --add item clock right \
  --set clock update_freq=10 \
    icon.font="Helvetica Neue:Bold:12.0" \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="open -a Calendar" \
  --subscribe clock system_woke

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change system_woke

sketchybar --add item weather right \
  --set weather icon="☁️" icon.font="Apple Color Emoji:Regular:14.0" \
    label="Weather --°C" label.max_chars=30 \
    update_freq=1800 script="$PLUGIN_DIR/weather.sh" \
  --subscribe weather system_woke

sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged
sketchybar --add item spotify right \
  --set spotify icon= icon.color="$GREEN_COLOR" \
    label.max_chars=45 scroll_texts=on \
    drawing=off updates=on update_freq=10 \
    script="$PLUGIN_DIR/spotify.sh" \
    click_script="open -a Spotify" \
  --subscribe spotify spotify_change system_woke

sketchybar --update
